# Virtual option enabled when the NCS implementation of RPL should be used
# instead of the Zephyr one.
config BT_MESH_RPL_NCS
	bool

choice BT_MESH_RPL_STORAGE_MODE
	prompt "Replay protection list storage mode"
	default BT_MESH_RPL_STORAGE_MODE_EMDS if EMDS

config BT_MESH_RPL_STORAGE_MODE_EMDS
	bool "Persistent storage of RPL in Emergency Data Storage"
	depends on EMDS
	select BT_MESH_RPL_NCS
	help
	  Persistent storage of RPL in Emergency Data Storage.

config BT_MESH_RPL_STORAGE_MODE_ZMS
	bool "Persistent storage of RPL in Zephyr Memory Storage"
	depends on ZMS
	select BT_MESH_RPL_NCS
	help
	  Persistent storage of RPL in Zephyr Memory Storage.

endchoice

if BT_MESH_RPL_STORAGE_MODE_EMDS

config BT_MESH_RPL_INDEX
	int "Unique index for the storage of RPL data"
	default 999
	help
	  This value defines the storage index for the RPL data in Emergency
	  Data Storage, and can not overlap with any other index in the
	  Emergency Data Storage.

endif # BT_MESH_RPL_STORAGE_MODE_EMDS

if BT_MESH_RPL_STORAGE_MODE_ZMS

config BT_MESH_RPL_ZMS_STORE_TIMEOUT
	int "Timeout for storing RPL data in Zephyr Memory Storage"
	range -1 1000000
	default 5
	help
	  This value defines the timeout in seconds for storing RPL data in
	  Zephyr Memory Storage. The RPL data will be stored after this timeout
	  if any changes have been made to the RPL.

endif # BT_MESH_RPL_STORAGE_MODE_ZMS
